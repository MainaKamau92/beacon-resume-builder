# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# archives / design source bundles (not needed to build or run)
*.zip

# real people's documents used as a local test corpus — never commit PII
# (synthetic/ is the exception: committed, PII-free, and required by the tests)
test_docs/*
!test_docs/synthetic/
knowledge/

# third-party design references (Canva templates) — kept locally, never redistributed
designs/canva-references/
